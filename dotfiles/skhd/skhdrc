# skhd — hotkeys for yabai.
#
# Modifier namespace: everything lives under Ctrl+Alt, with Shift for "move the
# window" and Cmd for "resize the window". That namespace was chosen because it
# is the one macOS leaves alone:
#
#   * Ctrl+1..9 and Ctrl+arrows (Mission Control spaces) are NOT bound here —
#     they stay native, which also keeps the sketchybar space islands working,
#     since those click-scripts synthesise Ctrl+n.
#   * Fn+Ctrl+arrows (native Tahoe tiling) and Ctrl+Cmd+F (full screen) are NOT
#     bound here.
#   * Ctrl+Alt is the VoiceOver modifier, but VoiceOver is off on this machine.
#     If you ever turn it on, move these to Ctrl+Alt+Cmd.
#
# Reload with: skhd --restart-service   (config changes are also hot-reloaded)

##### Focus #####
# hjkl and arrows both work. Focus wraps to the nearest window in that
# direction on the current space; on a float space that is whichever window is
# geometrically that way.
ctrl + alt - h : yabai -m window --focus west
ctrl + alt - j : yabai -m window --focus south
ctrl + alt - k : yabai -m window --focus north
ctrl + alt - l : yabai -m window --focus east

ctrl + alt - left  : yabai -m window --focus west
ctrl + alt - down  : yabai -m window --focus south
ctrl + alt - up    : yabai -m window --focus north
ctrl + alt - right : yabai -m window --focus east

# Cycle through the windows on this space, and back to the previously focused
# one. `recent` is the fastest way to bounce between two windows.
ctrl + alt - n : yabai -m window --focus next || yabai -m window --focus first
ctrl + alt - p : yabai -m window --focus prev || yabai -m window --focus last
ctrl + alt - tab : yabai -m window --focus recent

##### Move #####
# Swaps with the neighbour on a bsp space, nudges by 60px on a float space.
# See ~/.config/yabai/scripts/window-move.sh for why that split exists.
ctrl + alt + shift - h : ~/.config/yabai/scripts/window-move.sh west
ctrl + alt + shift - j : ~/.config/yabai/scripts/window-move.sh south
ctrl + alt + shift - k : ~/.config/yabai/scripts/window-move.sh north
ctrl + alt + shift - l : ~/.config/yabai/scripts/window-move.sh east

ctrl + alt + shift - left  : ~/.config/yabai/scripts/window-move.sh west
ctrl + alt + shift - down  : ~/.config/yabai/scripts/window-move.sh south
ctrl + alt + shift - up    : ~/.config/yabai/scripts/window-move.sh north
ctrl + alt + shift - right : ~/.config/yabai/scripts/window-move.sh east

##### Resize #####
# Direction = the way the edge travels, so east always widens to the right.
ctrl + alt + cmd - h : ~/.config/yabai/scripts/window-resize.sh west
ctrl + alt + cmd - j : ~/.config/yabai/scripts/window-resize.sh south
ctrl + alt + cmd - k : ~/.config/yabai/scripts/window-resize.sh north
ctrl + alt + cmd - l : ~/.config/yabai/scripts/window-resize.sh east

ctrl + alt + cmd - left  : ~/.config/yabai/scripts/window-resize.sh west
ctrl + alt + cmd - down  : ~/.config/yabai/scripts/window-resize.sh south
ctrl + alt + cmd - up    : ~/.config/yabai/scripts/window-resize.sh north
ctrl + alt + cmd - right : ~/.config/yabai/scripts/window-resize.sh east

# Centre the focused window at two-thirds of the display — the one placement
# macOS has no shortcut for and the most useful thing on a float space.
ctrl + alt - c : yabai -m window --grid 6:6:1:1:4:4

##### Layout #####
# The opt-in switch: flip this space between native (float) and tiled (bsp).
ctrl + alt - t : ~/.config/yabai/scripts/toggle-layout.sh

# Float or re-tile just the focused window, without changing the space.
ctrl + alt - space : yabai -m window --toggle float

# Zoom the focused window to fill its parent split, then back. bsp only —
# on a float space use the native green button or Fn+Ctrl+F.
ctrl + alt - m : yabai -m window --toggle zoom-parent
ctrl + alt + shift - m : yabai -m window --toggle zoom-fullscreen

# Rearrange a bsp space: rotate the tree 90 degrees, even out the splits, or
# flip it about an axis.
ctrl + alt - r : yabai -m space --rotate 90
ctrl + alt - e : yabai -m space --balance
ctrl + alt - x : yabai -m space --mirror x-axis
ctrl + alt - y : yabai -m space --mirror y-axis

# Toggle the split direction of the focused window, so the next window opens
# beside it instead of below it (or vice versa).
ctrl + alt - s : yabai -m window --toggle split

##### Service #####
ctrl + alt + shift - r : yabai --restart-service
