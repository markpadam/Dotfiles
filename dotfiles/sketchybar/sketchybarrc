#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Catppuccin Mocha color scheme + AeroSpace workspace integration

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ── Palette ──────────────────────────────────────────────────────────────────
# Defaults below are Catppuccin Mocha. The Hammerspoon theme switcher
# (dotfiles/hammerspoon/theme.lua) writes $CONFIG_DIR/theme.sh with BAR_*
# overrides for the active theme and runs `sketchybar --reload`; it's
# .gitignore'd. Every colour in this file is one of these vars so a theme swap
# is a single source of truth. (Plugin warning colours — cpu/mem/battery
# yellow+red thresholds — still live in the plugin scripts.)
# base:    0xff1e1e2e   crust:   0xff11111b   surface1: 0xff313244
# text:    0xffcdd6f4   subtext: 0xffa6adc8   overlay:  0xff6c7086
# green:   0xffa6e3a1   yellow:  0xfff9e2af   red:      0xfff38ba8
# mauve:   0xffcba6f7
[ -r "$CONFIG_DIR/theme.sh" ] && . "$CONFIG_DIR/theme.sh"
BAR_BG=${BAR_BG:-0xf01e1e2e}
BAR_ISLAND=${BAR_ISLAND:-0xf01e1e2e}
BAR_BORDER=${BAR_BORDER:-0xffcba6f7}
BAR_ACCENT=${BAR_ACCENT:-0xffcba6f7}
BAR_ACCENT_DIM=${BAR_ACCENT_DIM:-0x1acba6f7}
BAR_ACCENT_B=${BAR_ACCENT_B:-0x40cba6f7}
BAR_TEXT=${BAR_TEXT:-0xffcdd6f4}
BAR_SUBTEXT=${BAR_SUBTEXT:-0xffa6adc8}
BAR_SURFACE=${BAR_SURFACE:-0xff313244}
BAR_RED=${BAR_RED:-0xfff38ba8}
BAR_GREEN=${BAR_GREEN:-0xffa6e3a1}
BAR_YELLOW=${BAR_YELLOW:-0xfff9e2af}
BAR_BLUE=${BAR_BLUE:-0xff89b4fa}

# ── Bar appearance ────────────────────────────────────────────────────────────
# Shares the Opt+Space command menu's palette (dotfiles/hammerspoon/menu.lua):
# Hack Nerd Font Mono, a 2px accent border, base at ~0.94, the accent as
# the one highlight (the active workspace). Rounded and bold here, by choice.
sketchybar --bar \
    position=top          \
    height=24             \
    margin=8              \
    y_offset=2            \
    corner_radius=8       \
    blur_radius=20        \
    color="$BAR_BG"       \
    border_width=2        \
    border_color="$BAR_BORDER" \
    shadow=off            \
    topmost=window        \
    padding_left=12       \
    padding_right=12

# ── Global item defaults ──────────────────────────────────────────────────────
sketchybar --default \
    padding_left=4                                 \
    padding_right=4                                \
    icon.font="Hack Nerd Font Mono:Regular:13.0"   \
    label.font="Hack Nerd Font Mono:Bold:12.0"     \
    icon.color="$BAR_SUBTEXT"                      \
    label.color="$BAR_TEXT"                        \
    icon.padding_left=6                            \
    icon.padding_right=4                           \
    label.padding_left=4                           \
    label.padding_right=6

# ── LEFT: AeroSpace workspace indicators ──────────────────────────────────────
sketchybar --add event aerospace_workspace_change

COLOR="$BAR_ACCENT"   # the active-workspace accent (matches the menu)

# Five named workspaces (see dotfiles/aerospace/aerospace.toml). The Nerd Font
# glyph is the item *icon* and ws_label[i] is the *label*, so icon.padding_right
# sets the gap between them. The label is the workspace name with its alt-key
# number in brackets — e.g. `terminal (2)` is on alt-2 — kept decoupled from
# ws_name (the AeroSpace identifier, used by click_script and aerospace.sh) so
# the cosmetic suffix never touches AeroSpace. Glyphs are stored as UTF-8 byte
# escapes so tooling that rewrites this file can't silently strip the
# private-use codepoints. Material Design Icons range (F0000+); Hack Nerd Font
# Mono *Regular* carries both the MD and Font Awesome ranges. Glyphs:
#   F0379 monitor  F018D console  F059F web  F0361 message  F0293 code-tags
ws_name=(desktop            terminal         browser          comms          coding)
ws_label=("Desktop (1)"     "Terminal (2)"   "Browser (3)"    "Comms (4)"    "Coding (5)")
ws_icon=($'\xf3\xb0\x8d\xb9' $'\xf3\xb0\x86\x8d' $'\xf3\xb0\x96\x9f' $'\xf3\xb0\x8d\xa1' $'\xf3\xb0\x8a\x93')
for i in "${!ws_name[@]}"; do
    n="${ws_name[$i]}"
    sketchybar --add item space."$n" left \
        --subscribe space."$n" aerospace_workspace_change \
        --set space."$n" \
            background.color=0x00000000                    \
            background.corner_radius=6                     \
            background.height=18                           \
            background.drawing=off                         \
            icon="${ws_icon[$i]}"                          \
            icon.font="Hack Nerd Font Mono:Regular:13.0"   \
            icon.color="$BAR_SUBTEXT"                      \
            icon.padding_left=7                            \
            icon.padding_right=6                           \
            label="${ws_label[$i]}"                        \
            label.font="Hack Nerd Font Mono:Bold:11.0"     \
            label.color="$BAR_SUBTEXT"                     \
            label.padding_left=0                           \
            label.padding_right=7                          \
            padding_left=2                                 \
            padding_right=2                                \
            click_script="aerospace workspace $n"          \
            script="$PLUGIN_DIR/aerospace.sh $n $COLOR"
done

# Group workspace items under a shared background pill
sketchybar --add bracket workspaces '/space\..*/' \
    --set workspaces \
        background.color="$BAR_ACCENT_DIM" \
        background.corner_radius=8      \
        background.height=20            \
        background.border_width=1       \
        background.border_color="$BAR_ACCENT_B"

# ── LEFT: Frontmost app name ──────────────────────────────────────────────────
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off                                    \
        label.font="Hack Nerd Font Mono:Bold:12.0"          \
        label.color="$BAR_TEXT"                             \
        padding_left=10                                     \
        script="$PLUGIN_DIR/front_app.sh"                   \
    --subscribe front_app front_app_switched

# ── RIGHT: Clock ──────────────────────────────────────────────────────────────
sketchybar --add item clock right \
    --set clock \
        icon=""                     \
        icon.color="$BAR_SUBTEXT"   \
        icon.padding_left=0         \
        label.color="$BAR_TEXT"     \
        padding_left=4              \
        padding_right=4             \
        update_freq=10              \
        script="$PLUGIN_DIR/clock.sh"

# ── RIGHT: Battery ────────────────────────────────────────────────────────────
sketchybar --add item battery right \
    --set battery \
        label.color="$BAR_TEXT"     \
        update_freq=120             \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

# ── RIGHT: Volume ─────────────────────────────────────────────────────────────
sketchybar --add item volume right \
    --set volume \
        label.color="$BAR_TEXT"     \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

# ── RIGHT: CPU ───────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
    --set cpu \
        icon="󰻠"                   \
        icon.font="Hack Nerd Font Mono:Regular:13.0" \
        icon.color="$BAR_SUBTEXT"   \
        label.color="$BAR_TEXT"     \
        update_freq=10              \
        script="$PLUGIN_DIR/cpu.sh"

# ── RIGHT: Memory ─────────────────────────────────────────────────────────────
sketchybar --add item memory right \
    --set memory \
        label.color="$BAR_TEXT"     \
        update_freq=10              \
        script="$PLUGIN_DIR/memory.sh"

# ── RIGHT: Hammerspoon-driven state ──────────────────────────────────────────
# Hidden until Hammerspoon turns them on with `sketchybar --set hsq.<x> ...`:
#   media    now playing (services.lua)      caffeine  keep-awake (toggles.lua)
#   updates  brew outdated count             dnd       Do Not Disturb
#   rec      screen recording                zen       Zen mode
#   borders  borders hidden                  nightshift Night Shift
# The glyph (icon=) is set from the Lua side so the Nerd Font codepoints never
# have to live in this file.
for q in media updates rec borders nightshift zen dnd caffeine; do
    sketchybar --add item hsq.$q right \
        --set hsq.$q drawing=off \
            icon.font="Hack Nerd Font Mono:Regular:12.0" \
            icon.color="$BAR_ACCENT"                     \
            label.font="Hack Nerd Font Mono:Bold:11.0"   \
            label.color="$BAR_SUBTEXT"                   \
            padding_left=3 padding_right=3
done
sketchybar --set hsq.rec icon.color="$BAR_RED"
sketchybar --set hsq.updates icon.color="$BAR_YELLOW"

# ── Notch: two islands on the built-in, one bar on external displays ──────────
# Left- and right-hand background pills. Drawn only when the bar is on the
# notched built-in (toggled by notch_islands.sh); on an external display they
# stay hidden and the bar's own background is the single continuous bar.
sketchybar --add bracket left_island '/space\..*/' front_app \
    --set left_island \
        background.color="$BAR_ISLAND"  \
        background.corner_radius=8      \
        background.height=24            \
        background.border_width=2       \
        background.border_color="$BAR_BORDER" \
        background.drawing=off

sketchybar --add bracket right_island clock battery volume cpu memory \
        hsq.media hsq.updates hsq.rec hsq.borders hsq.nightshift hsq.zen hsq.dnd hsq.caffeine \
    --set right_island \
        background.color="$BAR_ISLAND"  \
        background.corner_radius=8      \
        background.height=24            \
        background.border_width=2       \
        background.border_color="$BAR_BORDER" \
        background.drawing=off

# Invisible worker: re-evaluates which layout to show on every display change.
sketchybar --add item notch_islands left \
    --set notch_islands drawing=off updates=on \
        script="$PLUGIN_DIR/notch_islands.sh" \
    --subscribe notch_islands display_change system_woke

# ── Trigger initial update ────────────────────────────────────────────────────
sketchybar --update
"$PLUGIN_DIR/notch_islands.sh"   # set the initial one-bar / two-island state
