#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Catppuccin Mocha color scheme + AeroSpace workspace integration

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ── Catppuccin Mocha palette ──────────────────────────────────────────────────
# base:    0xff1e1e2e   crust:   0xff11111b   surface1: 0xff313244
# text:    0xffcdd6f4   subtext: 0xffa6adc8   overlay:  0xff6c7086
# lavender:0xffb4befe   blue:    0xff89b4fa   pink:     0xfff5c2e7
# green:   0xffa6e3a1   yellow:  0xfff9e2af   red:      0xfff38ba8
# mauve:   0xffcba6f7

# ── Bar appearance ────────────────────────────────────────────────────────────
sketchybar --bar \
    position=top          \
    height=24             \
    margin=8              \
    y_offset=2            \
    corner_radius=8       \
    blur_radius=20        \
    color=0xcc1e1e2e      \
    border_width=1        \
    border_color=0x44cdd6f4 \
    shadow=off            \
    topmost=window        \
    padding_left=12       \
    padding_right=12

# ── Global item defaults ──────────────────────────────────────────────────────
sketchybar --default \
    padding_left=4                              \
    padding_right=4                             \
    icon.font="HackNerdFont-Bold:Bold:13.0"     \
    label.font="HackNerdFont-Bold:Bold:12.0"    \
    icon.color=0xffcdd6f4                       \
    label.color=0xffcdd6f4                      \
    icon.padding_left=6                         \
    icon.padding_right=4                        \
    label.padding_left=4                        \
    label.padding_right=6

# ── LEFT: AeroSpace workspace indicators ──────────────────────────────────────
sketchybar --add event aerospace_workspace_change

COLOR=0xff89b4fa

# Six named workspaces (see dotfiles/aerospace/aerospace.toml). The Nerd Font
# glyph is the item *icon* and ws_label[i] is the *label*, so icon.padding_right
# sets the gap between them. The label is the workspace name with its alt-key
# number in brackets — e.g. `terminal (2)` is on alt-2 — kept decoupled from
# ws_name (the AeroSpace identifier, used by click_script and aerospace.sh) so
# the cosmetic suffix never touches AeroSpace. Glyphs are stored as UTF-8 byte
# escapes so tooling that rewrites this file can't silently strip the
# private-use codepoints. Material Design Icons range (F0000+) only — the Font
# Awesome range (F108 etc.) is absent from Hack Nerd Font *Bold*. Glyphs:
#   F0379 monitor  F018D console  F059F web  F0361 message  F02D2 book  F10FE kubernetes
ws_name=(desktop            terminal         browser          comms          man          aks-lab)
ws_label=("desktop (1)"     "terminal (2)"   "browser (3)"    "comms (4)"    "man (5)"    "AKS Lab (6)")
ws_icon=($'\xf3\xb0\x8d\xb9' $'\xf3\xb0\x86\x8d' $'\xf3\xb0\x96\x9f' $'\xf3\xb0\x8d\xa1' $'\xf3\xb0\x8b\x92' $'\xf3\xb1\x83\xbe')
for i in "${!ws_name[@]}"; do
    n="${ws_name[$i]}"
    sketchybar --add item space."$n" left \
        --subscribe space."$n" aerospace_workspace_change \
        --set space."$n" \
            background.color=0x00000000              \
            background.corner_radius=6               \
            background.height=18                     \
            background.drawing=off                   \
            icon="${ws_icon[$i]}"                    \
            icon.font="HackNerdFont-Bold:Bold:13.0"  \
            icon.color=$COLOR                        \
            icon.padding_left=7                      \
            icon.padding_right=6                     \
            label="${ws_label[$i]}"                  \
            label.font="HackNerdFont-Bold:Bold:11.0" \
            label.color=$COLOR                       \
            label.padding_left=0                     \
            label.padding_right=7                    \
            padding_left=2                           \
            padding_right=2                          \
            click_script="aerospace workspace $n"    \
            script="$PLUGIN_DIR/aerospace.sh $n $COLOR"
done

# Group workspace items under a shared background pill
sketchybar --add bracket workspaces '/space\..*/' \
    --set workspaces \
        background.color=0x33313244     \
        background.corner_radius=8      \
        background.height=20            \
        background.border_width=1       \
        background.border_color=0x33cdd6f4

# ── LEFT: Frontmost app name ──────────────────────────────────────────────────
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off                                    \
        label.font="HackNerdFont-Bold:Bold:12.0"            \
        label.color=0xffa6adc8                              \
        padding_left=10                                     \
        script="$PLUGIN_DIR/front_app.sh"                   \
    --subscribe front_app front_app_switched

# ── RIGHT: Clock ──────────────────────────────────────────────────────────────
sketchybar --add item clock right \
    --set clock \
        icon=""                     \
        icon.color=0xff89b4fa       \
        icon.padding_left=0         \
        label.color=0xffcdd6f4      \
        padding_left=4              \
        padding_right=4             \
        update_freq=10              \
        script="$PLUGIN_DIR/clock.sh"

# ── RIGHT: Battery ────────────────────────────────────────────────────────────
sketchybar --add item battery right \
    --set battery \
        label.color=0xffcdd6f4      \
        update_freq=120             \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

# ── RIGHT: Volume ─────────────────────────────────────────────────────────────
sketchybar --add item volume right \
    --set volume \
        label.color=0xffcdd6f4      \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

# ── RIGHT: CPU ───────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
    --set cpu \
        icon="󰻠"                   \
        icon.font="HackNerdFont-Bold:Bold:13.0" \
        icon.color=0xffa6e3a1       \
        label.color=0xffcdd6f4      \
        update_freq=10              \
        script="$PLUGIN_DIR/cpu.sh"

# ── RIGHT: Memory ─────────────────────────────────────────────────────────────
sketchybar --add item memory right \
    --set memory \
        label.color=0xffcdd6f4      \
        update_freq=10              \
        script="$PLUGIN_DIR/memory.sh"

# ── Notch: two islands on the built-in, one bar on external displays ──────────
# Left- and right-hand background pills. Drawn only when the bar is on the
# notched built-in (toggled by notch_islands.sh); on an external display they
# stay hidden and the bar's own background is the single continuous bar.
sketchybar --add bracket left_island '/space\..*/' front_app \
    --set left_island \
        background.color=0xcc1e1e2e     \
        background.corner_radius=8      \
        background.height=24            \
        background.border_width=1       \
        background.border_color=0x44cdd6f4 \
        background.drawing=off

sketchybar --add bracket right_island clock battery volume cpu memory \
    --set right_island \
        background.color=0xcc1e1e2e     \
        background.corner_radius=8      \
        background.height=24            \
        background.border_width=1       \
        background.border_color=0x44cdd6f4 \
        background.drawing=off

# Invisible worker: re-evaluates which layout to show on every display change.
sketchybar --add item notch_islands left \
    --set notch_islands drawing=off updates=on \
        script="$PLUGIN_DIR/notch_islands.sh" \
    --subscribe notch_islands display_change system_woke

# ── Trigger initial update ────────────────────────────────────────────────────
sketchybar --update
"$PLUGIN_DIR/notch_islands.sh"   # set the initial one-bar / two-island state
