#!/usr/bin/env bash
# SketchyBar config — AeroSpace workspaces + front app on the left,
# tmux "PREFIX" indicator, battery and clock on the right.
# Palette: Catppuccin Mocha.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
export CONFIG_DIR PLUGIN_DIR

# --- Catppuccin Mocha ---
BASE=0xff1e1e2e
SURFACE0=0xff313244
SURFACE1=0xff45475a
TEXT=0xffcdd6f4
BLUE=0xff89b4fa
MAUVE=0xffcba6f7
GREEN=0xffa6e3a1
YELLOW=0xfff9e2af
RED=0xfff38ba8
FONT="Hack Nerd Font"

##############################################################################
# Bar + defaults
##############################################################################
sketchybar --bar \
    height=32 \
    position=top \
    padding_left=8 \
    padding_right=8 \
    color=$BASE \
    corner_radius=0 \
    y_offset=0

sketchybar --default \
    icon.font="$FONT:Bold:15.0" \
    icon.color=$TEXT \
    label.font="$FONT:Semibold:13.0" \
    label.color=$TEXT \
    padding_left=5 \
    padding_right=5 \
    icon.padding_left=6 \
    icon.padding_right=6 \
    label.padding_left=6 \
    label.padding_right=6 \
    background.corner_radius=6 \
    background.height=24

##############################################################################
# Custom events
##############################################################################
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change

##############################################################################
# LEFT: AeroSpace workspaces (1-9)
##############################################################################
for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
            icon="$sid" \
            icon.color=$TEXT \
            label.drawing=off \
            background.color=$SURFACE0 \
            background.drawing=off \
            click_script="aerospace workspace $sid" \
            script="$PLUGIN_DIR/aerospace.sh $sid"
done

##############################################################################
# LEFT: tmux PREFIX indicator + focused app name
##############################################################################
sketchybar --add item mode left \
    --subscribe mode aerospace_mode_change \
    --set mode \
        icon.drawing=off \
        label="PREFIX" \
        label.color=$BASE \
        label.font="$FONT:Bold:13.0" \
        background.color=$MAUVE \
        background.drawing=off \
        script="$PLUGIN_DIR/mode.sh"

sketchybar --add item front_app left \
    --subscribe front_app front_app_switched \
    --set front_app \
        icon.drawing=off \
        label.color=$BLUE \
        label.font="$FONT:Bold:13.0" \
        script="$PLUGIN_DIR/front_app.sh"

##############################################################################
# RIGHT: clock, then battery (right items are added right-to-left)
##############################################################################
sketchybar --add item clock right \
    --set clock \
        update_freq=10 \
        icon="" \
        icon.color=$MAUVE \
        script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
    --subscribe battery system_woke power_source_change \
    --set battery \
        update_freq=120 \
        script="$PLUGIN_DIR/battery.sh"

##############################################################################
# Finalize
##############################################################################
sketchybar --update
echo "sketchybar configuration loaded.."
