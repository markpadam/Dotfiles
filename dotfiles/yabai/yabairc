#!/usr/bin/env bash
# yabai — configured as an *extension* to the macOS window manager, not a
# replacement for it.
#
# The global layout is `float`, which is the whole point of this setup: yabai
# never moves a window on its own, so everything macOS already does keeps
# working untouched —
#   * native Tahoe tiling (drag-to-edge, green-button menu, Fn+Ctrl+arrows)
#   * manual drag / resize / zoom
#   * Mission Control, Ctrl+1..9 and Ctrl+arrows to switch spaces
#   * full-screen apps
# BSP tiling is opt-in per space: Ctrl+Alt+T toggles the current space between
# float and bsp (see ~/.config/skhd/skhdrc).
#
# SIP is left fully enabled, so the scripting addition is NOT loaded. Every
# setting below works without it. The features that would require it — moving
# windows between spaces, creating/destroying spaces, sticky windows, window
# opacity, PiP toggle, scratchpads — are deliberately absent rather than
# configured-and-silently-broken. See the block at the bottom of this file if
# you ever decide to disable SIP.
#
# Reload with: yabai --restart-service

##### Layout #####
# float is the default for every space. Spaces flipped to bsp by the toggle key
# keep that layout until you flip them back or log out.
yabai -m config layout float

# These only take effect on a space that is currently bsp; on a float space
# they are inert. Kept modest so a toggled space still looks like macOS.
yabai -m config top_padding    8
yabai -m config bottom_padding 8
yabai -m config left_padding   8
yabai -m config right_padding  8
yabai -m config window_gap     8

# A new window becomes the second leaf of the split, i.e. it opens to the
# right/below the window that was focused, which is the intuitive direction.
yabai -m config window_placement second_child
yabai -m config split_ratio       0.50
yabai -m config auto_balance      off

##### Mouse #####
# fn + drag anywhere in a window moves it; fn + right-drag resizes it. yabai
# only accepts a single modifier here (cmd|alt|shift|ctrl|fn) and fn is the one
# macOS and apps do not already claim for in-window drags — Option-drag and
# Cmd-drag both mean something in Finder, Figma, browsers, etc.
#
# If you ever use an external keyboard with no fn key, switch this to `ctrl`.
yabai -m config mouse_modifier fn
yabai -m config mouse_action1  move
yabai -m config mouse_action2  resize

# Dropping a window onto another on a bsp space swaps the two rather than
# stacking them (stacks are easy to create by accident and hard to notice).
yabai -m config mouse_drop_action swap

# Focus the window under the cursor without raising it. `autoraise` would also
# bring it to the front, which makes floating windows jump around as the
# pointer crosses them — `autofocus` keeps the stacking order stable.
yabai -m config focus_follows_mouse autofocus

# Deliberately off: this would teleport the pointer on every keyboard focus
# change, which fights focus_follows_mouse above.
yabai -m config mouse_follows_focus off

##### Bar #####
# sketchybar runs at height=28 / y_offset=0, which on this notched display sits
# entirely inside the 28pt safe-area strip that no window may occupy anyway, so
# no reserved space is needed. On a non-notched external display the bar can
# overlap the top few points of a tiled window; uncomment to reserve room.
# yabai -m config external_bar all:28:0

##### Rules #####
# With a float default these are not about floating — everything already
# floats. They mark windows as unmanaged so that they *stay* floating even on a
# space you have toggled to bsp. Settings panels, progress dialogs and
# utilities are the wrong shape for a tiling engine.
yabai -m rule --add app="^System Settings$"     manage=off
yabai -m rule --add app="^System Information$"  manage=off
yabai -m rule --add app="^Software Update$"     manage=off
yabai -m rule --add app="^Archive Utility$"     manage=off
yabai -m rule --add app="^Activity Monitor$"    manage=off
yabai -m rule --add app="^Calculator$"          manage=off
yabai -m rule --add app="^Dictionary$"          manage=off
yabai -m rule --add app="^App Store$"           manage=off
yabai -m rule --add app="^Disk Utility$"        manage=off
yabai -m rule --add app="^Keychain Access$"     manage=off
yabai -m rule --add app="^Font Book$"           manage=off
yabai -m rule --add app="^Photo Booth$"         manage=off
yabai -m rule --add app="^Weather$"             manage=off
yabai -m rule --add app="^Clock$"               manage=off
yabai -m rule --add app="^Calendar$"            manage=off
yabai -m rule --add app="^Karabiner-Elements$"  manage=off
yabai -m rule --add app="^CleanMyMac"           manage=off
yabai -m rule --add app="^Elgato"               manage=off
yabai -m rule --add app="^Stream Deck$"         manage=off
yabai -m rule --add app="^Steam$"               manage=off

# Finder's transient sheets (copy progress, Get Info, Connect to Server) are
# separate windows of the Finder process, so they need a title match.
yabai -m rule --add app="^Finder$" title="^(Copy|Move|Bin|Info|Connect|Finder Settings)" manage=off

# Apply the rules to windows that were already open when yabai started.
yabai -m rule --apply

##### Scripting addition (requires partially disabled SIP) #####
