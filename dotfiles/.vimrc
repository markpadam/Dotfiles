" ~/.vimrc

set nocompatible
syntax on
filetype plugin indent on

set number
set relativenumber
set nowrap
set tabstop=4
set shiftwidth=4
set expandtab
set smartindent
set clipboard=unnamedplus
set background=dark
set cursorline
set wildmenu
set incsearch
set ignorecase
set smartcase
set laststatus=2
set backspace=indent,eol,start
