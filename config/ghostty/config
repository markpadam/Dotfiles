# Ghostty terminal configuration.
# Named windows ("AKS-Lab", "IDE", "K8s Exam", "PowerShell 7", "Ubuntu" —
# what used to be iTerm dynamic profiles) are launched by ./launch, wired into
# the Hammerspoon menu (Opt+Space -> Terminal). See README.md.

# Theme. Both includes are optional (`?`) and later ones win, so the base
# `theme =` here is just the fallback:
#   theme.conf   — written by the Hammerspoon theme switcher (dotfiles/
#                  hammerspoon/theme.lua); this is the live source of truth.
#   wallust.conf — wallpaper-derived palette from config/wallust/ (older,
#                  unproven; kept for the odd manual `wallust run`).
# Both are .gitignore'd. theme.conf is last so the switcher always wins.
theme = Catppuccin Mocha
config-file = ?wallust.conf
config-file = ?theme.conf

# Font
font-family = JetBrains Mono
font-size = 13

# Window
window-padding-x = 12
window-padding-y = 8
window-theme = dark
macos-titlebar-style = hidden
window-padding-balance = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration = zsh

# Background opacity
background-opacity = 0.95

# Misc
copy-on-select = clipboard
confirm-close-surface = false
